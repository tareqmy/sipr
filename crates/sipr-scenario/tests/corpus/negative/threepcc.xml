<!-- expect: extended 3PCC -->
<!-- Classic -3pcc (sendCmd/recvCmd) is supported; the extended master/slave
     mode with src=/dest= peer routing is not, and must be rejected. -->
<scenario name="extended 3pcc">
  <recvCmd src="slave1">
    <action><ereg regexp="Content-Type:.*" search_in="msg" assign_to="1"/></action>
  </recvCmd>
  <recv response="200"/>
</scenario>
