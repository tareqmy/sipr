<scenario name="rtp_echo toggle (SIPp global echo switch)">
  <recv request="INVITE"/>
  <send><![CDATA[
    SIP/2.0 200 OK
    [last_Via:]
    [last_From:]
    [last_To:];tag=[pid]SIPpTag01[call_number]
    [last_Call-ID:]
    [last_CSeq:]
    Content-Length: 0

  ]]></send>
  <nop><action><rtp_echo value="0"/></action></nop>
  <pause milliseconds="100"/>
  <!-- The same switch driven from a variable (SIPp's handle_rhs form). -->
  <nop>
    <action>
      <add assign_to="echo_on" value="1"/>
      <rtp_echo variable="echo_on"/>
    </action>
  </nop>
  <recv request="BYE"/>
</scenario>
