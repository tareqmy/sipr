<scenario name="rtp_echo toggle (SIPp global echo switch)">
  <recv request="INVITE"/>
  <send><![CDATA[
    SIP/2.0 200 OK
    [last_Via:]
    [last_From:]
    [last_To:];tag=[pid]SIPpTag01[call_number]
    [last_Call-ID:]
    [last_CSeq:]
    Content-Length: 0

  ]]></send>
  <nop><action><rtp_echo value="0"/></action></nop>
  <pause milliseconds="100"/>
  <nop><action><rtp_echo value="1"/></action></nop>
  <recv request="BYE"/>
</scenario>
